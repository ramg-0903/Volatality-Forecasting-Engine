# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#   make env    # creates .env from this template if it does not exist
#
# docker compose reads .env automatically from the repo root.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=vfro
# Use alphanumerics only: this value is interpolated into a SQLAlchemy URL,
# where characters such as @ : / # would need percent-encoding.
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=volatility
MLFLOW_DB=mlflow

# Host-side port mapping. Change if something already listens on 5432.
POSTGRES_HOST_PORT=5432

# Connection strings.
#   ...HOST  - from your shell / notebooks / pytest, via the mapped port
#   ...DOCKER - from inside the compose network, via the service name
DATABASE_URL=postgresql+psycopg2://vfro:change_me_locally@localhost:5432/volatility
DATABASE_URL_DOCKER=postgresql+psycopg2://vfro:change_me_locally@postgres:5432/volatility

# -----------------------------------------------------------------------------
# MLflow
# -----------------------------------------------------------------------------
MLFLOW_VERSION=2.22.0

# Host default is 5001 because macOS AirPlay Receiver binds 5000.
# (System Settings > General > AirDrop & Handoff > AirPlay Receiver.)
MLFLOW_HOST_PORT=5001

MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_TRACKING_URI_DOCKER=http://mlflow:5000

# -----------------------------------------------------------------------------
# Data providers (used from day 3; keys not required for the day 1 scaffold)
# -----------------------------------------------------------------------------
# FRED: VIXCLS, DGS10, DGS3MO. Free key from fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Documented fallback market-data provider (build-plan section 4.1).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
NASDAQ_DATA_LINK_API_KEY=

# -----------------------------------------------------------------------------
# AWS (week 4 only; leave blank for local development)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
S3_ARTIFACT_BUCKET=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
